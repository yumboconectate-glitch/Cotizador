# Copia este archivo como .env y configura tus valores

# Llave de sesiones (genera una: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios

# URL publica del sistema (para enlaces de PDF, aceptacion y firma)
PUBLIC_URL=https://cotiza.tudominio.com

# === CORREO: usa un buzon dedicado para notificaciones ===
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=la-clave-del-buzon
SMTP_FROM=notificaciones@tudominio.com

# === API de automatizacion (n8n, bots) - opcional ===
N8N_API_KEY=genera-una-llave-larga-aleatoria
